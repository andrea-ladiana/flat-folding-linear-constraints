import Origami.Theorem1

/-!
# The hypergraph of the rows (Section 5 of the paper)

The vertices of `H_v` are the overlapping pairs of sectors, its hyperedges the rows.  Two
pairs are *linked* if some row contains both; components are the classes of the
equivalence relation generated by linking.  For every component, the sum of its rows
involves only its adjacent pairs (Lemma 2), so every solution of the rows satisfies one
equation per component containing adjacent pairs (`sum_comp_eq`, the easy half of
Lemma 3).  Together with Lemma 4 this is the upper half of Theorem 4.
-/

set_option linter.unusedSectionVars false

namespace Origami

variable {ι : Type*} [LinearOrder ι]
variable {α : Type*} [Field α] [LinearOrder α] [IsStrictOrderedRing α]

namespace Walk

variable {w : Walk ι α}

/-- Two pairs of sectors are linked if some row contains both. -/
def Linked (w : Walk ι α) (u v : Sym2 ι) : Prop := ∃ r ∈ w.rows, u ∈ r.verts ∧ v ∈ r.verts

/-- Connectivity in the hypergraph of the rows. -/
def Conn (w : Walk ι α) : Sym2 ι → Sym2 ι → Prop := Relation.EqvGen w.Linked

/-- The adjacent pair of sectors at the crease `k`. -/
def adj (w : Walk ι α) (k : ι) : Sym2 ι := s(k, nxt w.C k)

/-- The adjacent pairs at the creases `k` and `l` lie in one component of `H_v`. -/
def SameComp (w : Walk ι α) (k l : ι) : Prop := w.Conn (w.adj k) (w.adj l)

noncomputable instance (w : Walk ι α) (u v : Sym2 ι) : Decidable (w.Conn u v) := Classical.dec _
noncomputable instance (w : Walk ι α) (k l : ι) : Decidable (w.SameComp k l) := Classical.dec _

/-- `γ(v)`: the number of components of `H_v` that contain adjacent pairs. -/
noncomputable def gamma (w : Walk ι α) : ℕ := by
  classical exact (w.C.image fun k => Quot.mk w.Linked (w.adj k)).card

lemma conn_refl (u : Sym2 ι) : w.Conn u u := Relation.EqvGen.refl u
lemma conn_symm {u v : Sym2 ι} (h : w.Conn u v) : w.Conn v u := Relation.EqvGen.symm _ _ h
lemma conn_trans {u v z : Sym2 ι} (h : w.Conn u v) (h' : w.Conn v z) : w.Conn u z :=
  Relation.EqvGen.trans _ _ _ h h'
lemma conn_of_linked {u v : Sym2 ι} (h : w.Linked u v) : w.Conn u v := Relation.EqvGen.rel _ _ h

lemma sameComp_iff_quot {k l : ι} :
    w.SameComp k l ↔ Quot.mk w.Linked (w.adj k) = Quot.mk w.Linked (w.adj l) :=
  ⟨fun h => Quot.eqvGen_sound h, fun h => Quot.eqvGen_exact h⟩

/-! ### Sums of rows over a union of components -/

/-- A predicate on pairs that is constant on every row. -/
def RowClosed (w : Walk ι α) (P : Sym2 ι → Prop) : Prop :=
  ∀ r ∈ w.rows, ∀ u ∈ r.verts, ∀ v ∈ r.verts, P u → P v

lemma rowClosed_conn (u₀ : Sym2 ι) : w.RowClosed (w.Conn u₀) := by
  intro r hr u hu v hv h
  exact conn_trans h (conn_of_linked ⟨r, hr, hu, hv⟩)

/-- The rows all of whose vertices satisfy `P`. -/
def rowsIn (w : Walk ι α) (P : Sym2 ι → Prop) [DecidablePred P] : Finset (Row ι) :=
  w.rows.filter fun r => ∃ u ∈ r.verts, P u

/-- **Component sums.**  For a row-closed `P` and `d` symmetric on the sectors, the rows whose
vertices satisfy `P` add up, at `d`, to the sum of `d` over the adjacent pairs satisfying `P`. -/
theorem sum_rowsIn_symm (P : Sym2 ι → Prop) [DecidablePred P] (hP : w.RowClosed P)
    {d : ι → ι → ZMod 2} (hd : w.SymmOn d) (h3 : 3 ≤ w.C.card) :
    ∑ r ∈ w.rowsIn P, r.eval d = ∑ k ∈ w.C.filter (fun k => P (w.adj k)), d k (nxt w.C k) := by
  have hsub : w.rowsIn P ⊆ w.rows := Finset.filter_subset _ _
  rw [Finset.sum_congr rfl fun r hr => eval_eq_sum_verts hd (hsub hr)]
  -- double counting inside the selected rows
  have hdc : ∀ f : Sym2 ι → ZMod 2, ∑ r ∈ w.rowsIn P, ∑ u ∈ r.verts, f u =
      ∑ u ∈ w.C.sym2, (((w.rowsIn P).filter fun r => u ∈ r.verts).card : ZMod 2) * f u := by
    intro f
    have : ∀ r ∈ w.rowsIn P, ∑ u ∈ r.verts, f u =
        ∑ u ∈ w.C.sym2, if u ∈ r.verts then f u else 0 := by
      intro r hr
      rw [Finset.sum_ite_mem, Finset.inter_eq_right.2 (verts_subset_sym2 (hsub hr))]
    rw [Finset.sum_congr rfl this, Finset.sum_comm]
    refine Finset.sum_congr rfl fun u _ => ?_
    rw [Finset.card_eq_sum_ones, Nat.cast_sum, Finset.sum_mul, Finset.sum_filter]
    simp
  rw [hdc]
  -- the selected rows containing `u` are all the rows containing `u`, or none
  have hcoef : ∀ u ∈ w.C.sym2, (((w.rowsIn P).filter fun r => u ∈ r.verts).card : ZMod 2) =
      if P u ∧ u ∈ w.adjPairs then 1 else 0 := by
    intro u hu
    by_cases hPu : P u
    · have : (w.rowsIn P).filter (fun r => u ∈ r.verts) = w.rowsWith u := by
        ext r
        simp only [rowsIn, rowsWith, Finset.mem_filter]
        constructor
        · rintro ⟨⟨hr, -⟩, hm⟩; exact ⟨hr, hm⟩
        · rintro ⟨hr, hm⟩; exact ⟨⟨hr, u, hm, hPu⟩, hm⟩
      rw [this, card_rowsWith_mod_two hu h3]
      simp [hPu]
    · have : (w.rowsIn P).filter (fun r => u ∈ r.verts) = ∅ := by
        rw [Finset.eq_empty_iff_forall_notMem]
        intro r hr
        simp only [rowsIn, Finset.mem_filter] at hr
        obtain ⟨⟨hr, v, hv, hPv⟩, hm⟩ := hr
        exact hPu (hP r hr v hv u hm hPv)
      rw [this]; simp [hPu]
  rw [Finset.sum_congr rfl fun u hu => by rw [hcoef u hu]]
  simp only [ite_mul, one_mul, zero_mul]
  rw [← Finset.sum_filter]
  have hfil : w.C.sym2.filter (fun u => P u ∧ u ∈ w.adjPairs) =
      (w.C.filter fun k => P (w.adj k)).image fun k => s(k, nxt w.C k) := by
    ext u
    simp only [Finset.mem_filter, Finset.mem_image]
    constructor
    · rintro ⟨-, hPu, hu⟩
      obtain ⟨k, hk, rfl⟩ := Finset.mem_image.1 hu
      exact ⟨k, ⟨hk, hPu⟩, rfl⟩
    · rintro ⟨k, ⟨hk, hPk⟩, rfl⟩
      exact ⟨Finset.mk_mem_sym2_iff.2 ⟨hk, w.nxt_mem hk⟩, hPk, Finset.mem_image.2 ⟨k, hk, rfl⟩⟩
  rw [hfil, Finset.sum_image (fun a ha b hb h => mk_nxt_injOn h3 (Finset.mem_of_mem_filter a ha)
    (Finset.mem_of_mem_filter b hb) h)]
  exact Finset.sum_congr rfl fun k hk =>
    symm2_eq hd (Finset.mem_of_mem_filter k hk) (w.nxt_mem (Finset.mem_of_mem_filter k hk))
      (w.nxt_ne (Finset.mem_of_mem_filter k hk)).symm

/-- **Component equations (Lemma 3, easy half).**  Two solutions of the rows have the same
sum of adjacent variables over the creases of every component. -/
theorem sum_comp_eq {x y : ι → ι → ZMod 2} (hx : w.Antisymm x) (hy : w.Antisymm y)
    (hsx : w.IsSol x) (hsy : w.IsSol y) (h3 : 3 ≤ w.C.card) (k₀ : ι) :
    ∑ k ∈ w.C.filter (fun k => w.SameComp k₀ k), x k (nxt w.C k) =
      ∑ k ∈ w.C.filter (fun k => w.SameComp k₀ k), y k (nxt w.C k) := by
  classical
  have hd : w.SymmOn (x + y) := by
    intro i hi j hj hij
    simp only [Pi.add_apply]
    rw [hx i hi j hj hij, hy i hi j hj hij]
    generalize x i j = a; generalize y i j = b
    revert a b; decide
  have := sum_rowsIn_symm (w.Conn (w.adj k₀)) (rowClosed_conn _) hd h3
  have h0 : ∑ r ∈ w.rowsIn (w.Conn (w.adj k₀)), r.eval (x + y) = 0 := by
    refine Finset.sum_eq_zero fun r hr => ?_
    have hr' := (Finset.mem_filter.1 hr).1
    rw [Row.eval_add, hsx r hr', hsy r hr', add_zero]
  rw [h0] at this
  simp only [Pi.add_apply, Finset.sum_add_distrib] at this
  unfold SameComp
  generalize ∑ k ∈ w.C.filter (fun k => w.Conn (w.adj k₀) (w.adj k)), x k (nxt w.C k) = A at this ⊢
  generalize ∑ k ∈ w.C.filter (fun k => w.Conn (w.adj k₀) (w.adj k)), y k (nxt w.C k) = B at this ⊢
  revert A B; decide

/-! ### `W_lin` is an affine subspace -/

/-- A set of assignments closed under `σ₁ + σ₂ + σ₃` (affine combinations over `𝔽₂`). -/
def IsAff {V : Type*} [Add V] (S : Set V) : Prop := ∀ a ∈ S, ∀ b ∈ S, ∀ c ∈ S, a + b + c ∈ S

lemma isAff_Wlin : IsAff w.Wlin := by
  rintro _ ⟨x, hx, hsx, rfl⟩ _ ⟨y, hy, hsy, rfl⟩ _ ⟨z, hz, hsz, rfl⟩
  refine ⟨x + y + z, ?_, ?_, ?_⟩
  · intro i hi j hj hij
    simp only [Pi.add_apply]
    rw [hx i hi j hj hij, hy i hi j hj hij, hz i hi j hj hij]
    generalize x i j = a; generalize y i j = b; generalize z i j = c
    revert a b c; decide
  · intro r hr
    rw [Row.eval_add, Row.eval_add, hsx r hr, hsy r hr, hsz r hr]; decide
  · funext k
    simp only [asg, Pi.add_apply]
    generalize x k (nxt w.C k) = a; generalize y k (nxt w.C k) = b
    generalize z k (nxt w.C k) = c
    split_ifs <;> revert a b c <;> decide

end Walk

end Origami
